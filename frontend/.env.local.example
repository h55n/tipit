# Copy to .env.local and fill in after deploying the contract

# Deployed contract address on Sepolia
NEXT_PUBLIC_CONTRACT_ADDRESS=0xYourDeployedContractAddressHere

# Optional: your QuickNode Sepolia HTTP endpoint (prevents rate-limiting)
# Same URL as QUICKNODE_SEPOLIA_URL in the root .env
NEXT_PUBLIC_RPC_URL=https://your-endpoint.quiknode.pro/your-api-key/
