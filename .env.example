# Copy this file to .env and fill in your values
# NEVER commit .env to git

# QuickNode Sepolia HTTP endpoint
# Get one free at https://www.quicknode.com/
QUICKNODE_SEPOLIA_URL=https://your-endpoint.quiknode.pro/your-api-key/

# Private key of your BURNER deployer wallet (no leading 0x)
# Fund it from https://sepoliafaucet.com/ or https://www.alchemy.com/faucets/ethereum-sepolia
DEPLOYER_PRIVATE_KEY=your_64_char_hex_private_key_here

# Etherscan API key for contract verification (optional)
# Get one at https://etherscan.io/myapikey
ETHERSCAN_API_KEY=your_etherscan_api_key_here
